# FoundryVTT Docker – Umgebungsvariablen
# Kopiere diese Datei: cp .env.example .env
# und trage deine Werte ein. Niemals .env in Git committen!

# ── Foundry Account (für automatischen Download beim Build) ─────────────────
FOUNDRY_USERNAME=your-foundry-username
FOUNDRY_PASSWORD=your-foundry-password

# ── Foundry Version ──────────────────────────────────────────────────────────
# 13.x = letzte Version mit deutscher Übersetzung
FOUNDRY_VERSION=13.351

# ── Domain ───────────────────────────────────────────────────────────────────
DOMAIN=foundry.yourdomain.com

# ── Backup ───────────────────────────────────────────────────────────────────
BACKUP_REPO=git@github.com:youruser/foundryvtt-backups.git
BACKUP_SCHEDULE=0 3 * * *
BACKUP_BRANCH=main
BACKUP_GIT_EMAIL=your@email.com
# SSH Deploy Key (Base64-kodiert) – erzeugen mit:
#   ssh-keygen -t ed25519 -C "foundry-backup" -f /tmp/backup_key -N ""
#   cat /tmp/backup_key | base64 -w 0
# Den Public Key (/tmp/backup_key.pub) als Deploy Key im GitHub-Repo hinterlegen (mit Write-Zugriff).
BACKUP_SSH_KEY=