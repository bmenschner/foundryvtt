# Phase 2: HTTPS-Konfiguration – aktiv NACH erfolgreicher Zertifikatsausstellung
# Aktivieren: cp nginx/foundry.conf.template nginx/default.conf && docker compose exec nginx nginx -s reload

# ── HTTP → HTTPS Redirect ───────────────────────────────────────────────────
server {
    listen 80;
    server_name foundry.bastianmenschner.de;

    # ACME Challenge muss auch auf Port 80 erreichbar bleiben (für Renewal)
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ── HTTPS mit WebSocket Proxy ───────────────────────────────────────────────
server {
    listen 443 ssl;
    http2  on;
    server_name foundry.bastianmenschner.de;

    # Let's Encrypt Zertifikat
    ssl_certificate     /etc/letsencrypt/live/foundry.bastianmenschner.de/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/foundry.bastianmenschner.de/privkey.pem;

    # Certbot-empfohlene SSL-Einstellungen
    include     /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # Große Uploads erlauben (Karten, Token, Musik, etc.)
    client_max_body_size 300M;

    location / {
        proxy_pass         http://foundry:30000;
        proxy_http_version 1.1;

        # WebSocket-Support (zwingend für FoundryVTT Echtzeit-Engine!)
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_read_timeout  90s;
        proxy_send_timeout  90s;
        proxy_buffering     off;   # Wichtig für Echtzeit-Streaming
    }
}

# ── Lokaler Zugriff auf Port 30000 (nur localhost) ─────────────────────────
# Erreichbar unter: http://localhost:30000
# Kein SSL, kein Domain-Check – für lokale Entwicklung / Debugging
server {
    listen 30000;
    server_name localhost 127.0.0.1;

    location / {
        proxy_pass         http://foundry:30000;
        proxy_http_version 1.1;

        # WebSocket-Support (zwingend für FoundryVTT!)
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto http;

        client_max_body_size 300M;
        proxy_read_timeout   90s;
    }
}


