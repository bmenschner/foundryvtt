# FoundryVTT Docker – Umgebungsvariablen
# ACHTUNG: Diese Datei enthält Secrets – niemals in Git committen!

# ── Foundry Account (für automatischen Download beim Build) ─────────────────
FOUNDRY_USERNAME=bmenschner
FOUNDRY_PASSWORD=qzy_tmv8EKN3cpv3cqf

# ── Foundry Version ──────────────────────────────────────────────────────────
FOUNDRY_VERSION=14.359

# ── Domain ───────────────────────────────────────────────────────────────────
DOMAIN=foundry.bastianmenschner.de

# ── Backup ───────────────────────────────────────────────────────────────────
# SSH-URL des privaten GitHub-Repos
BACKUP_REPO=git@github.com:bmenschner/foundryvtt-backups.git

# Cron-Zeitplan (Standard: täglich 03:00 Uhr)
BACKUP_SCHEDULE=0 3 * * *

# Branch im Backup-Repo
BACKUP_BRANCH=main

# Git-Commit-Author E-Mail
BACKUP_GIT_EMAIL=bastian@menschner.de
